# Instant Loan Pre-Decision API — configuration
#
# Every variable below is validated by a schema at boot. The process exits on a
# bad or missing value BEFORE it binds a port, so a misconfiguration is a failed
# deploy rather than a service that answers requests insecurely.
#
# Copy to .env for local development. In a deployed environment the secrets are
# set in the platform's secret store, never in the image or the repository.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------- database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/predecision
DATABASE_POOL_MAX=10

# Migrations run inside a Postgres advisory lock, so two instances booting
# together cannot both migrate. Without the lock this setting is a race.
MIGRATE_ON_BOOT=true

# ---------------------------------------------------------------- secrets
# NO DEFAULTS, deliberately.
#
# SUBJECT_KEY_PEPPER: a defaulted pepper would be a shared secret baked into the
# image, and every deployment would derive the same subject keys from the same
# identifiers. Rotating it makes previously stored subject keys unlinkable to
# newly derived ones, so it is a long-lived secret and rotation is a migration.
SUBJECT_KEY_PEPPER=

# Token lists, comma separated, in the form <clientId>:<secret>. The client id
# is what lands in applications.client_id and in the idempotency key, so it must
# be stable per integrator.
#
# The schema REFUSES TO START when NODE_ENV=production and any of these is
# empty. Auth documented as mandatory that defaults to off is worse than no auth,
# because it reads as protected.
API_TOKENS=acme-web:dev-submission-token
REVIEWER_TOKENS=underwriting:dev-reviewer-token
AUDITOR_TOKENS=compliance:dev-auditor-token

# ---------------------------------------------------------------- policy
# Must name a file that exists in POLICY_DIR, or boot fails. Old versions are
# never deleted: replay loads the version recorded on the pre-decision, not this
# one. See ADR-0005.
POLICY_VERSION=2026.09.1
POLICY_DIR=./policies

# Recorded on every pre-decision. A change to the engine's arithmetic must bump
# this, or a reproducibility failure becomes indistinguishable from tampering.
ENGINE_VERSION=1.0.0

# ---------------------------------------------------------------- bureau
BUREAU_PROVIDER=MOCKBUREAU

# A risk decision, not a technical one: how stale a credit picture may be and
# still back a new pre-decision. Fifteen minutes is safe; twenty-four hours is
# not obviously safe. The right owner of this number is a risk manager.
BUREAU_REPORT_TTL_MINUTES=15

# The timing budget. These five numbers are chosen together to fit the p95 in
# docs/00-scope.md A2 — see docs/02-idempotency.md §4.4 before changing any one
# of them.
#
#   worst case for a winner  = 800 + ~150 jitter + 800  ~= 1.8 s
#   BUREAU_WAIT_MS must EXCEED that, or a loser gives up while the winner is
#   still succeeding.
#   BUREAU_CLAIM_LEASE_MS must exceed it with margin, and stay short enough that
#   a crashed holder delays one applicant by seconds, not half a minute.
BUREAU_TIMEOUT_MS=800
BUREAU_MAX_ATTEMPTS=2
BUREAU_BACKOFF_BASE_MS=150
BUREAU_CLAIM_LEASE_MS=5000
BUREAU_WAIT_MS=2000
BUREAU_WAIT_POLL_MS=100

# ---------------------------------------------------------------- mock bureau
# none | error | timeout | flaky. The identifiers 900-55-9001 and 900-55-9002
# force a failure without any configuration, which is how the failure path is
# demonstrated on the deployed instance. This switch is for tests.
MOCK_BUREAU_FAILURE_MODE=none
MOCK_BUREAU_LATENCY_MS=120
MOCK_BUREAU_FAILURES_BEFORE_SUCCESS=2

# ---------------------------------------------------------------- idempotency
# MUST NOT exceed ORPHAN_SWEEP_AFTER_MINUTES in effect, or a retry can arrive
# against a key whose application the sweeper already retired. The sweeper marks
# the key ABANDONED in the same transaction, so the two stay consistent; this
# value only governs how long a COMPLETED key can still be replayed.
IDEMPOTENCY_RETENTION_HOURS=24

# How long a holder owns a key before another request may take it over and
# RESUME the application it created. Must exceed the worst-case request.
IDEMPOTENCY_LEASE_SECONDS=30

# ---------------------------------------------------------------- orphans
# An application left in RECEIVED by a process that died mid-pull, whose caller
# never retried. Nothing else would ever resolve it.
ORPHAN_SWEEP_AFTER_MINUTES=15
ORPHAN_SWEEP_INTERVAL_MINUTES=5
