    "/v1/audit/pre-decisions/{applicationId}/replay": {
      "post": {
        "summary": "Re-run the engine against the stored inputs",
        "tags": [
          "audit"
        ],
        "description": "Uses the STORED application, the STORED bureau lookup, the policy version RECORDED ON THE\nPRE-DECISION, and `submittedAt` as the clock — never today's policy, never a fresh bureau call,\nnever today's wall clock. The clock matters: `screen` derives age at maturity from it, so\nreplaying with now() would turn an applicant who was 74 at maturity into an age decline and\nreport tampering where there is none.\n\nIt compares the ENGINE's verdict, never the composed outcome. A human who overrode a referral\ndid not tamper with anything, and flagging them would make every legitimate override look like\nfraud. An `engineVersion` difference is reported but does not make `match` false on its own —\nthat is what the column is for.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "in": "path",
            "name": "applicationId",
            "required": true
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Replay"
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
